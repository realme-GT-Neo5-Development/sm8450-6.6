# The UART node uses compatible "qcom,msm-geni-console", matched only with
# SERIAL_MSM_GENI_CONSOLE. Without a bound driver this interconnect consumer
# keeps icc_sync_state() from running and the boot-time INT_MAX votes on
# DDR/LLCC block CX/DDR collapse. The console itself stays disabled by
# default, as in msm-5.10.
CONFIG_SERIAL_MSM_GENI_CONSOLE=m
CONFIG_SERIAL_MSM_GENI_HALF_SAMPLING=y
# CONFIG_SERIAL_MSM_GENI_CONSOLE_DEFAULT_ENABLED is not set

# Bind the remaining GCC consumers so clock sync_state can run and turn off
# unused clocks. PMIC arbiter debug is not enabled in msm-5.10, but its node
# blocks sync_state on 6.6 when left unbound.
CONFIG_QCOM_LLCC_PERFMON=m
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=m

# Power options enabled in msm-5.10 waipio_GKI.config.
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_ZRAM_WRITEBACK=y

# Notification LED (AW210xx on I2C, replaces the PMIC RGB LED on senna).
CONFIG_LEDS_AW210XX=m
CONFIG_LEDS_QPNP_VIBRATOR_LDO=m
CONFIG_LEDS_QTI_FLASH=m
CONFIG_LEDS_QTI_TRI_LED=m

# Fixed version string so that out-of-tree modules built separately share
