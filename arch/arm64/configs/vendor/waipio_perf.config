CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m

# Modules loaded by the senna vendor image.
CONFIG_QCOM_GPI_DMA=m
CONFIG_DRM_LT9611UXC=m

# The upstream pmic_glink/ucsi_glink drivers bind the same PMIC_RTR_ADSP_APPS
# rpmsg channel as the QTI drivers (qti_pmic_glink, ucsi_qti_glink) used by
# this platform and race with them for it. msm-5.10 only has the QTI ones.
# CONFIG_QCOM_PMIC_GLINK is not set
# CONFIG_UCSI_PMIC_GLINK is not set

# Reboot immediately on panic, as in msm-5.10.
CONFIG_PANIC_TIMEOUT=-1

# No framebuffer console: DRM_FBDEV_EMULATION references msm_fbdev code that
# the display techpack does not provide, and simpledrm would hold the splash
# framebuffer that msm_drm takes over.
# CONFIG_VT is not set
# CONFIG_VT_CONSOLE is not set
# CONFIG_DRM_SIMPLEDRM is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FONT_SUPPORT is not set
# CONFIG_FONT_8x16 is not set
# CONFIG_FONTS is not set
# CONFIG_FONT_TER16x32 is not set

# gki_defconfig without console=ttynull (CONFIG_NULL_TTY is off, see below).
CONFIG_CMDLINE="stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off kvm-arm.mode=protected bootconfig ioremap_guard"

# ttynull registers a console unconditionally, which starts init's console
# service and makes Android warn about an enabled serial console. msm-5.10
# does not have it.
# CONFIG_NULL_TTY is not set

# PMIC power key, loaded in first stage like on the vendor image.
CONFIG_INPUT_QPNP_POWER_ON=m
CONFIG_MSM_ADSPRPC=m

# Must be built as a signed module: it exports protected symbols.
CONFIG_TIPC=m

CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
CONFIG_SENSORS_SSC=m

# CONFIG_CFI_PERMISSIVE is not set

# The vendor 5.10 kernel is built with LTO.
CONFIG_LTO_CLANG_THIN=y

CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# CPUCP (RIMPS in msm-5.10) and the SCMI vendor protocols it exposes. The
# CPUCP firmware on this SoC implements the legacy per-protocol interface
# (PLH 0x81, PMU 0x86, C1DCVS 0x87), not QTI_SCMI_VENDOR_PROTOCOL.
CONFIG_QCOM_CPUCP=m
CONFIG_QTI_CPUCP_LOG=m

# Disabled as in msm-5.10. The WLAN techpack turns SLUB_DEBUG into
# PANIC_ON_BUG, making every QDF_BUG() assertion fatal.
# CONFIG_SLUB_DEBUG is not set
